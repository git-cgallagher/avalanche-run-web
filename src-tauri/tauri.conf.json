{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avalanche Run",
  "version": "0.4.0",
  "identifier": "net.cgallagher.avalancherun",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Avalanche Run",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "ArcadeGame",
    "shortDescription": "Outrun the avalanche.",
    "longDescription": "An original downhill skiing arcade game: dodge trees, rocks and the locals, hit ramps for tricks, and outrun the avalanche.",
    "copyright": "Copyright (c) 2026 Chris Gallagher. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
